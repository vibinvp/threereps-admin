// ADMIN PANEL RULES — MERGE INTO THE LIVE RULESET, DO NOT DEPLOY STANDALONE.
//
// The Firebase project is shared with the user app and trainer app, whose rules
// are not in this repo. Deploying this file by itself would replace those rules and
// break the mobile apps. Export the live rules from the Firebase console first
// (Firestore > Rules), paste these helpers + blocks inside
// `match /databases/{database}/documents { ... }`, and test in the emulator.
//
// Admin roster: documents in `admins` keyed by the admin's Auth UID with
// { role: 'admin' | 'superadmin', isActive: true }. The panel's login also
// accepts roster docs with auto IDs (matched by email), but rules can't query by
// email, so MIGRATE any auto-ID admin docs to uid-keyed docs before enforcing.

function isSignedIn() { return request.auth != null; }

function adminDoc() {
  return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
}

function isAdmin() {
  return isSignedIn()
    && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
    && adminDoc().role in ['admin', 'superadmin']
    && adminDoc().get('isActive', true) != false;
}

function isSuperAdmin() { return isAdmin() && adminDoc().role == 'superadmin'; }

// ---- Admin-only collections (full definitions) -------------------------------

match /admins/{adminId} {
  allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
  allow write: if isSuperAdmin();
}

// Written only by Cloud Functions / Admin SDK (bypass rules). Admins may read.
match /audit_logs/{id}         { allow read: if isAdmin(); allow write: if false; }
match /app_config_audit/{id}   { allow read: if isAdmin(); allow write: if false; }
match /manual_refund_queue/{id}{ allow read: if isAdmin(); allow write: if false; }
match /adminNotifications/{id} { allow read: if isAdmin(); allow write: if false; }
match /slot_locks/{id}         { allow read: if isAdmin(); allow write: if false; }

// Money records: admins read; mutations should go through Cloud Functions.
// (The panel currently updates these from the client — move to functions in Phase 2.)
match /ledger/{id}             { allow read: if isAdmin(); allow write: if isAdmin(); }
match /payment_sessions/{id}   { allow read: if isAdmin(); allow write: if isAdmin(); }
match /support_tickets/{id}    { allow read: if isAdmin(); allow write: if isAdmin(); }

// Content managed from the panel; public read where the apps/website need it.
match /landing_page/{id}       { allow read: if true; allow write: if isAdmin(); }
match /cms/{id}                { allow read: if true; allow write: if isAdmin(); }
match /legal_content/{id}      { allow read: if true; allow write: if isAdmin(); }
match /banners/{id}            { allow read: if true; allow write: if isAdmin(); }
match /languages/{id}          { allow read: if true; allow write: if isAdmin(); }
match /service_areas/{id}      { allow read: if true; allow write: if isAdmin(); }
match /categories/{id}         { allow read: if true; allow write: if isAdmin(); }
match /session_patterns/{id}   { allow read: if true; allow write: if isAdmin(); }
match /trainer_tiers/{id}      { allow read: if true; allow write: if isAdmin(); }

// ---- Shared with the mobile apps: ADD `|| isAdmin()` to the existing rules ---
//   users, trainers, bookings, sessions, attendance
// e.g. in the existing `match /trainers/{id}`:  allow read, write: if <existing> || isAdmin();
