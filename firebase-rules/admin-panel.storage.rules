// ADMIN PANEL STORAGE RULES — MERGE into the live storage ruleset (shared project).
// Paths written by the panel: banners/, landing/, trainers/{id}/profile|certificates/

function isAdmin() {
  return request.auth != null
    && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
    && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
}

match /banners/{allPaths=**}  { allow read: if true; allow write: if isAdmin(); }
match /landing/{allPaths=**}  { allow read: if true; allow write: if isAdmin(); }
// Trainer files: keep existing owner rules and add `|| isAdmin()` for write.
// match /trainers/{trainerId}/{allPaths=**} { allow read: if request.auth != null; allow write: if request.auth.uid == trainerId || isAdmin(); }
