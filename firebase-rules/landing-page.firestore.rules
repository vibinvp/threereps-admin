// Add INSIDE the existing `match /databases/{database}/documents { ... }` block of your
// Firestore rules. It only touches the new `landing_page` collection, so existing
// rules for the user app, trainer app and admin panel are unchanged.
//
// Public read (the website has no login). Writes only for admins listed in `admins`.

match /landing_page/{docId} {
  allow read: if true;
  allow write: if request.auth != null
    && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
    && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
}

// Storage (optional, only if image uploads from the Landing Page tab are denied):
